@model EditAcaoViewModel

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-controller="Acao" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @Html.AntiForgeryToken()
    @Html.HiddenFor(a => a.Id)

    <div class="mb-3">
        <label class="form-label">Nome da Empresa</label>
        <input type="text" class="form-control" asp-for="Name" readonly>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Ano de Entrada na Bolsa</label>
        <input type="number" class="form-control" asp-for="AnoEntrada">
        <span asp-validation-for="AnoEntrada" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Tickers</label>
        <input type="text" class="form-control" asp-for="Tickers">
        <span asp-validation-for="Tickers" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Setor</label>
        <select class="form-select" asp-for="IdSetor" asp-items="Model.opcoesSetores">
        </select>
        <span asp-validation-for="IdSetor" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="Estatal">
        <label class="form-check-label">
            Empresa Estatal
        </label>
        <span asp-validation-for="Estatal" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger" asp-controller="Acao" asp-action="Delete" asp-route-id="@Model.Id" formmethod="post" onclick="return confirm('Confirma excluir esta ação?');">
        Excluir
    </button>

    <button type="submit" class="btn btn-primary">
        Editar
    </button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}