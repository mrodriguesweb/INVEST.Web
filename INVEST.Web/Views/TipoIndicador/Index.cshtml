@model IEnumerable<INVEST.Web.ViewModels.IndicadoresVM.TipoIndicadorViewModel>

@{
    ViewData["Title"] = "Gestão de Tipos de Indicadores";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-sliders"></i> Tipos de Indicadores</h2>

        <a href="#" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Indicador
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 25%;">Nome do Indicador</th>
                            <th style="width: 15%;">Tipo de Dado</th>
                            <th style="width: 45%;">Parâmetros de Qualidade (Mín - Máx)</th>
                            <th style="width: 10%;" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Nenhum tipo de indicador cadastrado.
                                </td>
                            </tr>
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@item.Name</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.TipoDescricao
                                    </span>
                                </td>
                                <td>
                                    @if (item.Qualidades.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var qualidade in item.Qualidades)
                                            {
                                                <span class="badge bg-secondary p-2" style="font-size: 0.85rem;">
                                                    <i class="bi bi-arrows-expand"></i> Faixa:
                                                    @qualidade.ValorMinimo.ToString("G") até @qualidade.ValorMaximo.ToString("G")
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sem parâmetros definidos</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="TipoIndicador" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar Indicador">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>